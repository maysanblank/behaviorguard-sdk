{
  "name": "behaviorguard-sdk",
  "version": "3.0.0",
  "type": "module",
  "description": "Behavioral-biometrics account-takeover detection with a built-in step-up: the page measures, your own server keeps the profile and decides. Zero dependencies.",
  "scripts": {
    "reproduce": "python research/reproduce_db.py",
    "reproduce:ablation": "python research/reproduce_db.py --ablation",
    "reproduce:simple": "python research/reproduce_simple.py",
    "demo": "python demo/arunika/server.py",
    "sync-core": "powershell -ExecutionPolicy Bypass -File tools/sync_core.ps1",
    "prebuild": "npm run sync-core",
    "build:extension": "npm run sync-core",
    "bundle": "python tools/bundle.py",
    "build": "python tools/bundle.py",
    "conformance": "python core/conformance.py",
    "conformance:js": "python -m http.server 8099 (then open /core/conformance.html)",
    "drift": "python core/drift_check.py",
    "golden": "python core/gen_golden.py",
    "conformance:node": "node core/conformance.node.mjs",
    "test:idle": "node core/idle.test.mjs",
    "test:idle:live": "node core/idle.live.test.mjs",
    "test:invariance": "node core/invariance.test.mjs",
    "test:audit": "node core/audit.test.mjs",
    "holdout:c23": "python research/canonical_holdout.py",
    "ablation:idle": "python research/idle_ablation.py",
    "conformance:rust": "cd ports/rust && cargo run --release",
    "conformance:java": "java ports/java/BgConformance.java core/golden.json",
    "build:wasm": "cd ports/rust && cargo build --release --target wasm32-unknown-unknown --lib && cp target/wasm32-unknown-unknown/release/bg_core.wasm ../wasm/bg_core.wasm",
    "conformance:wasm": "node ports/wasm/run.mjs",
    "test:c46": "node core/c46.test.mjs",
    "eval:typing": "node research/eval_typing.mjs --sweep",
    "demo:local": "python -m http.server 8080",
    "server": "python server/app.py",
    "test:server": "python server/test_app.py",
    "test:parity": "python server/test_parity.py",
    "test:rhythm": "python server/test_rhythm.py",
    "test:backend": "python server/test_backend_sdk.py",
    "test:demos": "python demo/arunika/test_server.py && python demo/shop-checkout/test_install.py"
  },
  "license": "MIT",
  "author": "May San",
  "repository": {
    "type": "git",
    "url": "https://github.com/maysanblank/behaviorguard-sdk"
  },
  "keywords": [
    "behavioral-biometrics",
    "account-takeover",
    "continuous-authentication",
    "keystroke-dynamics",
    "fraud-detection",
    "self-hosted",
    "zero-dependency",
    "mfa",
    "step-up-auth"
  ],
  "files": [
    "sdk/",
    "dist/",
    "core/SPEC.md",
    "core/golden.json",
    "ports/",
    "LICENSE",
    "README.md",
    "server/guard.py",
    "server/engine.py",
    "server/rhythm.py",
    "server/app.py",
    "server/dashboard.html",
    "core/bg_core.py"
  ]
}
