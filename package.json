{
  "name": "behaviorguard-sdk",
  "version": "2.2.0",
  "type": "module",
  "description": "On-device behavioral-biometrics ATO detection with built-in step-up MFA. One brain, five runtimes, zero dependencies.",
  "scripts": {
    "reproduce": "python tools/reproduce_db.py",
    "reproduce:ablation": "python tools/reproduce_db.py --ablation",
    "reproduce:simple": "python tools/reproduce_simple.py",
    "demo": "npx serve demo -l 8080",
    "sync-core": "powershell -ExecutionPolicy Bypass -File tools/sync_core.ps1",
    "prebuild": "npm run sync-core",
    "build:extension": "npm run sync-core",
    "bundle": "python tools/bundle.py",
    "build": "python tools/bundle.py",
    "conformance": "python core/conformance.py",
    "conformance:js": "python -m http.server 8099 (lalu buka /core/conformance.html)",
    "drift": "python core/drift_check.py",
    "golden": "python core/gen_golden.py",
    "conformance:node": "node core/conformance.node.mjs",
    "test:idle": "node core/idle.test.mjs",
    "test:idle:live": "node core/idle.live.test.mjs",
    "test:invariance": "node core/invariance.test.mjs",
    "test:audit": "node core/audit.test.mjs",
    "holdout:c23": "python tools/canonical_holdout.py",
    "ablation:idle": "python tools/idle_ablation.py",
    "conformance:rust": "cd ports/rust && cargo run --release",
    "conformance:java": "java ports/java/BgConformance.java core/golden.json",
    "build:wasm": "cd ports/rust && cargo build --release --target wasm32-unknown-unknown --lib && cp target/wasm32-unknown-unknown/release/bg_core.wasm ../wasm/bg_core.wasm",
    "conformance:wasm": "node ports/wasm/run.mjs",
    "test:c46": "node core/c46.test.mjs",
    "eval:typing": "node tools/eval_typing.mjs --sweep"
  },
  "license": "MIT",
  "author": "May San",
  "repository": {
    "type": "git",
    "url": "https://github.com/maysanblank/behaviorguard-sdk"
  },
  "keywords": [
    "behavioral-biometrics",
    "account-takeover",
    "continuous-authentication",
    "keystroke-dynamics",
    "fraud-detection",
    "on-device",
    "zero-dependency",
    "mfa",
    "step-up-auth"
  ],
  "files": [
    "sdk/",
    "dist/",
    "loader/",
    "core/SPEC.md",
    "core/golden.json",
    "ports/",
    "LICENSE",
    "README.md"
  ]
}
